---
import BaseLayout from "../layouts/BaseLayout.astro";

const findings = [
  {
    number: "01",
    title: "RIGHT-OF-WAY PERMITS",
    text: "City records show Flock ALPR installations in Lee's Summit public right-of-way.",
    href: "/records#permits"
  },
  {
    number: "02",
    title: "THE MONEY",
    text: "Invoices and contract documents show the costs behind Lee's Summit's Flock program.",
    href: "/records#money"
  },
  {
    number: "03",
    title: "THE CONTRACT",
    text: "The five-year agreement lists a total contract value of $909,150.",
    href: "/records#contract"
  },
  {
    number: "04",
    title: "VEHICLE FINGERPRINT",
    text: "The contract describes technology capable of identifying more than just a license plate.",
    href: "/records#fingerprint"
  },
  {
    number: "05",
    title: "DATA RETENTION",
    text: "Flock's standard retention period is 30 days, while records can also be downloaded and archived.",
    href: "/records#retention"
  },
  {
    number: "06",
    title: "INSIDE THE SYSTEM",
    text: "A month of the department's own search audit log shows 2,699 searches reaching camera networks shared with 1,729 outside organizations.",
    href: "/records#flock-audit"
  }
];
---

<BaseLayout
  title="DeFlock Lee's Summit"
  description="DeFlock Lee's Summit is a citizen-led effort opposing automated license plate reader surveillance in Lee's Summit, Missouri."
  containerWidth="1120px"
>
  <style>
    .hero {
      padding: 105px 0 95px;
      border-bottom: 1px solid #292929;
    }

    .eyebrow {
      color: #d22b2b;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 2px;
      margin-bottom: 20px;
    }

    h1 {
      font-size: clamp(54px, 8vw, 105px);
      line-height: 0.9;
      letter-spacing: -5px;
      max-width: 950px;
      margin: 0 0 32px;
      font-weight: 900;
    }

    .hero p {
      max-width: 690px;
      color: #c6c6c6;
      font-size: 20px;
      line-height: 1.6;
      margin-bottom: 38px;
    }

    .deflock-callout {
      margin: 30px 0;
      padding: 18px 24px;
      background: #141414;
      border: 1px solid #292929;
      border-left: 4px solid #d22b2b;
      color: #ccc;
      font-size: 14px;
      line-height: 1.6;
    }

    .deflock-callout a {
      color: #fff;
      font-weight: 800;
      text-decoration: underline;
    }

    .buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .button {
      display: inline-block;
      padding: 15px 22px;
      border: 1px solid #f5f5f5;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.8px;
    }

    .button.primary {
      background: #d22b2b;
      border-color: #d22b2b;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border-bottom: 1px solid #292929;
    }

    .stat {
      padding: 45px 30px;
      border-right: 1px solid #292929;
    }

    .stat:last-child {
      border-right: 0;
    }

    .stat strong {
      display: block;
      font-size: 37px;
      margin-bottom: 8px;
    }

    .stat span {
      color: #888;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1px;
    }

    section {
      padding: 85px 0;
    }

    .section-heading {
      margin-bottom: 45px;
    }

    .section-heading small {
      color: #d22b2b;
      font-weight: 800;
      letter-spacing: 2px;
    }

    h2 {
      font-size: clamp(36px, 5vw, 62px);
      margin: 10px 0;
      letter-spacing: -2px;
    }

    .records {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .record {
      background: #141414;
      border: 1px solid #292929;
      padding: 30px;
      min-height: 280px;
      display: flex;
      flex-direction: column;
      transition: .15s ease;
    }

    .record:hover {
      border-color: #d22b2b;
      transform: translateY(-2px);
    }

    .record-number {
      color: #d22b2b;
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .record h3 {
      margin-top: 45px;
      font-size: 24px;
    }

    .record p {
      color: #aaa;
      line-height: 1.6;
    }

    .record-link {
      margin-top: auto;
      padding-top: 22px;
      font-size: 12px;
      font-weight: 900;
      letter-spacing: .8px;
    }

    .record-link span {
      color: #d22b2b;
    }

    .mission {
      background: #f1f1ee;
      color: #111;
    }

    .mission p {
      max-width: 800px;
      font-size: 21px;
      line-height: 1.7;
    }

    .involved-intro {
      max-width: 720px;
      color: #aaa;
      font-size: 19px;
      line-height: 1.7;
    }

    .involved-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-top: 40px;
    }

    .involved-card {
      display: flex;
      flex-direction: column;
      min-height: 350px;
      padding: 32px;
      background: #141414;
      border: 1px solid #2c2c2c;
    }

    .card-number {
      color: #d22b2b;
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 2px;
    }

    .involved-card h3 {
      margin: 55px 0 16px;
      font-size: 25px;
    }

    .involved-card p {
      color: #aaa;
      line-height: 1.65;
    }

    .action-link {
      margin-top: auto;
      color: #fff;
      font-size: 12px;
      font-weight: 900;
    }

    .featured-card {
      background: #d22b2b;
      border-color: #d22b2b;
    }

    .featured-card .card-number,
    .featured-card p {
      color: white;
    }

    .contact-options {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: auto;
    }

    .contact-button {
      display: block;
      padding: 13px 15px;
      background: white;
      color: #111;
      font-size: 12px;
      font-weight: 900;
      text-align: center;
    }

    .secondary-contact {
      background: transparent;
      color: white;
      border: 1px solid rgba(255,255,255,.6);
    }

    .meeting-callout {
      margin-top: 16px;
      padding: 38px 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
      background: #141414;
      border-left: 5px solid #d22b2b;
    }

    .meeting-callout h3 {
      margin: 7px 0 10px;
      font-size: 25px;
    }

    .meeting-callout p {
      max-width: 720px;
      margin: 0;
      color: #999;
      line-height: 1.6;
    }

    .callout-label {
      color: #d22b2b;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 2px;
    }

    @media (max-width: 800px) {
      h1 {
        letter-spacing: -3px;
      }

      .stats,
      .records,
      .involved-grid {
        grid-template-columns: 1fr;
      }

      .stat {
        border-right: 0;
        border-bottom: 1px solid #292929;
      }

      .hero {
        padding: 75px 0;
      }

      .meeting-callout {
        flex-direction: column;
        align-items: flex-start;
        padding: 30px;
      }
    }
  </style>

  <main>

  <section class="hero">
    <div class="container">

      <div class="eyebrow">
        CITIZEN-LED • LEE'S SUMMIT, MISSOURI
      </div>

      <h1>
        OUR STREETS<br />
        ARE NOT A<br />
        DATABASE.
      </h1>

      <p>
        DeFlock Lee's Summit is a citizen-led effort demanding an end
        to automated vehicle surveillance on our public streets.
        We're obtaining the records, publishing what we find,
        and organizing residents who want the cameras removed.
      </p>

      <div class="buttons">

    <a class="button primary" href="/records">
      READ THE RECORDS
    </a>

    <a class="button" href="/sunshine">
      TRACK OUR REQUESTS
    </a>

    <a class="button" href="#involved">
      GET INVOLVED
    </a>

  </div>

    </div>
  </section>


  <div class="container">

    <div class="deflock-callout">
      Part of a growing, nationwide movement &mdash; track ALPR camera
      locations across the country at{" "}
      <a href="https://deflock.org" target="_blank" rel="noopener noreferrer">DeFlock.org</a>
    </div>

  </div>


  <div class="container">

    <div class="stats">

      <div class="stat">
        <strong>$909,150</strong>
        <span>5-YEAR CONTRACT TOTAL</span>
      </div>

      <div class="stat">
        <strong>$175K</strong>
        <span>RECURRING ANNUAL COST</span>
      </div>

      <div class="stat">
        <strong>30 DAYS</strong>
        <span>STANDARD FLOCK RETENTION</span>
      </div>

      <div class="stat">
        <strong>55</strong>
        <span>UNITS LISTED IN ORDER FORM</span>
      </div>

    </div>

  </div>


  <section>
    <div class="container">

      <div class="section-heading">
        <small>PUBLIC RECORDS</small>
        <h2>FROM THE RECORDS</h2>

        <p>
          No rumors. Read the documents for yourself.
        </p>
      </div>

      <div class="records">

        {findings.map((finding) => (

          <a href={finding.href} class="record">

            <div class="record-number">
              RECORD {finding.number}
            </div>

            <h3>{finding.title}</h3>

            <p>{finding.text}</p>

            <div class="record-link">
              VIEW RECORD <span>→</span>
            </div>

          </a>

        ))}

      </div>

    </div>
  </section>


  <section class="mission" id="mission">
    <div class="container">

      <div class="section-heading">
        <small>WHY WE'RE HERE</small>
        <h2>THE MISSION IS SIMPLE.</h2>
      </div>

      <p>
        We believe Lee's Summit can investigate crime without building
        a searchable record of ordinary people traveling through their
        own community.
      </p>

      <p>
        We're asking the City of Lee's Summit to end its automated
        license plate reader program and remove these cameras from
        the public right-of-way.
      </p>

    </div>
  </section>


  <section id="involved">
    <div class="container">

      <div class="section-heading">

        <small>THIS TAKES PEOPLE</small>

        <h2>GET INVOLVED.</h2>

        <p class="involved-intro">
          You don't have to be an expert on ALPR technology.
          Show up, ask questions, read the records, and help make sure
          Lee's Summit residents are heard.
        </p>

      </div>


      <div class="involved-grid">

        <div class="involved-card">

          <div class="card-number">01</div>

          <h3>JOIN THE COMMUNITY</h3>

          <p>
            Join the DeFlock Lee's Summit Facebook group to connect
            with other residents and help organize local efforts.
          </p>

          <a
            class="action-link"
            href="https://www.facebook.com/share/g/1F9SxUd93S/"
            target="_blank"
            rel="noopener noreferrer"
          >
            JOIN THE FACEBOOK GROUP →
          </a>

        </div>


        <div class="involved-card">

          <div class="card-number">02</div>

          <h3>FOLLOW THE PAGE</h3>

          <p>
            Follow the public page for records, updates, meeting
            information and new findings.
          </p>

          <a
            class="action-link"
            href="https://www.facebook.com/profile.php?id=61592899809324"
            target="_blank"
            rel="noopener noreferrer"
          >
            FOLLOW DEFLOCK LEE'S SUMMIT →
          </a>

        </div>


        <div class="involved-card featured-card">

          <div class="card-number">03</div>

          <h3>READY TO DO MORE?</h3>

          <p>
            Want to speak at City Hall, review records, attend meetings,
            make signs, volunteer or share information?
          </p>

          <div class="contact-options">

            <a
              class="contact-button"
              href="/contact"
            >
              CONTACT US
            </a>

            <a
              class="contact-button secondary-contact"
              href="mailto:contact@deflockls.com"
            >
              contact@deflockls.com
            </a>

          </div>

        </div>

      </div>


      <div class="meeting-callout">

        <div>

          <span class="callout-label">
            SHOW UP
          </span>

          <h3>
            YOUR VOICE MATTERS AT CITY HALL.
          </h3>

          <p>
            We're looking for Lee's Summit residents willing to attend
            public meetings, speak during public comment, or simply
            show up in support.
          </p>

        </div>

        <a
          class="button primary"
          href="/take-action"
        >
          TAKE ACTION →
        </a>

      </div>

    </div>
  </section>

  </main>

</BaseLayout>
