---
import BaseLayout from "../layouts/BaseLayout.astro";
import { updates, slugifyUpdateTitle } from "../data/updates";
---

<BaseLayout
  title="Updates | DeFlock Lee's Summit"
  description="A running changelog of new records, features, and additions to the DeFlock Lee's Summit site."
  containerWidth="900px"
>
  <style>
    .hero {
      padding: 75px 0 55px;
      border-bottom: 1px solid #292929;
    }

    .eyebrow {
      color: #d22b2b;
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 2px;
    }

    h1 {
      margin: 12px 0 20px;
      font-size: clamp(48px, 8vw, 82px);
      line-height: .95;
      letter-spacing: -4px;
    }

    .intro {
      max-width: 700px;
      color: #aaa;
      font-size: 18px;
      line-height: 1.7;
    }

    .rss-link {
      display: inline-block;
      margin-left: 10px;
      color: #fff;
      font-size: 14px;
      font-weight: 800;
      text-decoration: underline;
    }

    .updates-list {
      padding: 60px 0 90px;
    }

    .update-entry {
      display: grid;
      grid-template-columns: 130px 1fr;
      gap: 24px;
      padding: 28px 0;
      border-bottom: 1px solid #292929;
    }

    .update-entry:first-child {
      padding-top: 0;
    }

    .update-date {
      color: #777;
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 1px;
      white-space: nowrap;
      padding-top: 3px;
    }

    .update-title {
      margin: 0 0 8px;
      font-size: 19px;
      font-weight: 800;
    }

    .update-body {
      margin: 0;
      color: #aaa;
      line-height: 1.7;
      font-size: 15px;
      max-width: 620px;
    }

    @media (max-width: 600px) {
      .update-entry {
        grid-template-columns: 1fr;
        gap: 6px;
      }
    }
  </style>

  <main id="main-content">

    <section class="hero">
      <div class="container">

        <div class="eyebrow">
          CHANGELOG
        </div>

        <h1>
          UPDATES
        </h1>

        <p class="intro">
          What's new on the site, most recent first.
          <a href="/rss.xml" class="rss-link">Subscribe via RSS →</a>
        </p>

      </div>
    </section>


    <section class="updates-list">
      <div class="container">

        {updates.map((update) => (
          <div class="update-entry" id={`${update.date}-${slugifyUpdateTitle(update.title)}`}>
            <div class="update-date">{update.date}</div>
            <div>
              <h3 class="update-title">{update.title}</h3>
              <p class="update-body">{update.body}</p>
            </div>
          </div>
        ))}

      </div>
    </section>

  </main>

</BaseLayout>
