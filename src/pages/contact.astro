---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | DeFlock Lee's Summit"
  description="Contact DeFlock Lee's Summit, volunteer, share information, or get involved."
  containerWidth="900px"
>
  <style>
    main {
      padding: 80px 0 110px;
    }

    .eyebrow {
      color: #d22b2b;
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 2px;
    }

    h1 {
      margin: 12px 0 18px;
      font-size: clamp(48px, 8vw, 82px);
      line-height: .95;
      letter-spacing: -4px;
    }

    .intro {
      max-width: 650px;
      color: #aaa;
      font-size: 18px;
      line-height: 1.7;
      margin-bottom: 45px;
    }

    .contact-layout {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 18px;
    }

    .form-panel,
    .info-panel {
      background: #141414;
      border: 1px solid #292929;
      padding: 32px;
    }

    label {
      display: block;
      margin-bottom: 8px;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    input,
    select,
    textarea {
      width: 100%;
      margin-bottom: 22px;
      padding: 14px;
      background: #0b0b0b;
      border: 1px solid #444;
      color: white;
      font: inherit;
    }

    textarea {
      min-height: 170px;
      resize: vertical;
    }

    button {
      width: 100%;
      border: 0;
      padding: 16px;
      background: #d22b2b;
      color: white;
      font-weight: 900;
      letter-spacing: 1px;
      cursor: pointer;
    }

    button:hover {
      background: #b82323;
    }

    button:disabled {
      background: #6b1a1a;
      cursor: not-allowed;
    }

    .form-status {
      display: none;
      margin-top: 18px;
      padding: 16px;
      font-size: 13px;
      line-height: 1.6;
      border: 1px solid #444;
    }

    .form-status.visible {
      display: block;
    }

    .form-status.success {
      border-color: #3fae5c;
      color: #8fe0a8;
    }

    .form-status.error {
      border-color: #d22b2b;
      color: #f5a3a3;
    }

    .info-panel h2 {
      margin-top: 0;
    }

    .info-panel p {
      color: #aaa;
      line-height: 1.6;
    }

    .email {
      color: #fff !important;
      font-weight: 800;
    }

    .privacy-note {
      margin-top: 16px;
      color: #777;
      font-size: 12px;
      line-height: 1.6;
    }

    @media (max-width: 700px) {
      .contact-layout {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <main>

    <div class="container">

      <div class="eyebrow">
        GET INVOLVED
      </div>

      <h1>LET'S TALK.</h1>

      <p class="intro">
        Want to help? Have information we should look into?
        Interested in speaking at a public meeting?
        Send us a message.
      </p>


      <div class="contact-layout">

        <div class="form-panel">

          <!-- CONTACT FORM STARTS HERE -->

          <form
            id="contact-form"
            action="https://api.web3forms.com/submit"
            method="POST"
          >

            <!-- WEB3FORMS ACCESS KEY -->
            <input
              type="hidden"
              name="access_key"
              value="14fcf2ac-707b-4b2a-906e-ee800f1aa0d7"
            />

            <input
              type="hidden"
              name="subject"
              value="New DeFlock Lee's Summit Website Message"
            />

            <input
              type="hidden"
              name="from_name"
              value="DeFlock Lee's Summit Website"
            />


            <label for="name">
              NAME
            </label>

            <input
              id="name"
              name="name"
              type="text"
              required
            />


            <label for="email">
              EMAIL
            </label>

            <input
              id="email"
              name="email"
              type="email"
              required
            />


            <label for="reason">
              WHAT ARE YOU REACHING OUT ABOUT?
            </label>

            <select
              id="reason"
              name="reason"
            >

              <option>Getting involved</option>

              <option>Speaking at City Hall</option>

              <option>Public records</option>

              <option>Share information</option>

              <option>Signs / materials</option>

              <option>Media inquiry</option>

              <option>Other</option>

            </select>


            <label for="message">
              MESSAGE
            </label>

            <textarea
              id="message"
              name="message"
              required
            ></textarea>


            <!-- SIMPLE SPAM TRAP -->
            <input
              type="checkbox"
              name="botcheck"
              style="display:none"
            />


            <button type="submit">
              SEND MESSAGE
            </button>

            <div class="form-status" id="form-status" role="status"></div>

            <p class="privacy-note">
              This form is delivered through a third-party form processor
              (Web3Forms) and goes only to DeFlock Lee's Summit organizers.
              We don't sell or share your information, and we won't use it
              for anything other than responding to you.
            </p>

          </form>

          <!-- CONTACT FORM ENDS HERE -->

        </div>


        <aside class="info-panel">

          <h2>OTHER WAYS TO REACH US</h2>

          <p>
            You can also contact DeFlock Lee's Summit directly:
          </p>

          <p class="email">
            <a href="mailto:contact@deflockls.com">
              contact@deflockls.com
            </a>
          </p>

          <p>
            We're especially looking for Lee's Summit residents
            interested in attending public meetings, reviewing records,
            and helping organize locally.
          </p>

        </aside>

      </div>

    </div>

  </main>

  <script>
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const status = document.getElementById("form-status");

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!status) return;

      const submitButton = form.querySelector("button[type=submit]") as HTMLButtonElement | null;
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = "SENDING...";
      }

      status.className = "form-status";
      status.textContent = "";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const result = await response.json();

        if (response.ok && result.success) {
          status.textContent =
            "Thanks — your message has been sent. We'll get back to you soon.";
          status.className = "form-status visible success";
          form.reset();
        } else {
          throw new Error(result.message || "Something went wrong.");
        }
      } catch (err) {
        status.textContent =
          "Something went wrong sending your message. Please try again or email contact@deflockls.com directly.";
        status.className = "form-status visible error";
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = "SEND MESSAGE";
        }
      }
    });
  </script>

</BaseLayout>
