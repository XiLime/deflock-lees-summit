  justify-content: space-between;
  gap: 20px;
  padding: 15px 0;
  border-bottom: 1px solid #292929;
  color: #aaa;
}

.billing-row strong {
  color: #fff;
}

.total-row {
  color: #fff;
  font-weight: 900;
}

.recurring-row {
  color: #d22b2b;
  font-weight: 900;
}

.source-box {
