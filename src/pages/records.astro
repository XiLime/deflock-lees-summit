}

.big-number-label {
  margin-top: 8px;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 2px;
}

.money-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  margin-top: 18px;
}

.money-card {
  background: #141414;
  border: 1px solid #292929;
  padding: 28px;
}

.money-card h3 {
  margin: 25px 0 10px;
  font-size: 23px;
}

.money-card p {
  color: #aaa;
  line-height: 1.65;
}

.money-amount {
  font-size: 42px;
  font-weight: 900;
  letter-spacing: -2px;
  margin-bottom: 18px;
}

.featured-money {
  border-color: #d22b2b;
}

.billing-summary {
  margin-top: 35px;
  background: #141414;
  border: 1px solid #292929;
