---
import BaseLayout from "../layouts/BaseLayout.astro";

const requests = [
  {
    id: "2026-275",
    date: "August 24, 2026",
    title: "Flock Safety Audit Records",
    status: "PENDING",
    statusClass: "pending",
    summary:
      "A narrowly focused request for audit reports, audit summaries, compliance reviews, findings, violations, discrepancies, and corrective or disciplinary action relating to LSPD's use of Flock.",
    requestPdf:
      "/documents/sunshine/2026-08-24_audit_request_submission_PUBLIC.pdf",
    responsePdf:
      "/documents/sunshine/2026-08-24_audit_request_city_response_PUBLIC.pdf",
    officialFormPdf:
      "/documents/sunshine/2026-08-24_official_records_request_form_PUBLIC.pdf",
    timeline: [
      {
        date: "AUG 24",
        title: "REQUEST SUBMITTED",
        text: "Requested existing audit records covering January 1, 2025 through August 24, 2026."
      },
      {
        date: "AUG 24",
        title: "CITY CLERK RESPONSE",
        text: "The City confirmed receipt and stated that if the records cannot be provided within three business days, a detailed explanation for the delay and the date and time the records will be available will be provided."
      }
    ]
  },

  {
    id: "AUG-12-2026",
    date: "August 12, 2026",
    title: "Flock Policy, Audits, Retention and Annual Report Records",
    status: "PENDING",
    statusClass: "pending",
    summary:
      "Requested the policies and records supporting LSPD's statements about safeguards, Flock searches, retention, audits, hotlist alerts, expanded database access, outside-agency access, and the 2025 Annual Report.",
    requestPdf:
      "/documents/sunshine/2026-08-12_flock_policy_request_submission_PUBLIC.pdf",
    responsePdf:
      "/documents/sunshine/2026-08-13_flock_policy_city_response_PUBLIC.pdf",
    officialFormPdf:
      "/documents/sunshine/2026-08-12_official_records_request_form_PUBLIC.pdf",
    timeline: [
      {
        date: "AUG 12",
        title: "REQUEST SUBMITTED",
        text: "Requested Flock policies, prior policies, contracts, retention rules, training materials, audit records, 2025 search logs, hotlist statistics and outside-agency access records."
      },
      {
        date: "AUG 13",
        title: "FORWARDED TO LSPD",
        text: "The City forwarded the request to the Lee's Summit Police Department Records Unit."
      },
      {
        date: "AUG 13",
        title: "LSPD RESPONSE",
        text: "LSPD said additional time was required and estimated production within 25 to 30 business days."
      }
    ]
  },

  {
    id: "AUG-10-2026",
    date: "August 10, 2026",
    title: "Flock Ownership, Cost, Installation and Operations",
    status: "PENDING",
    statusClass: "pending",
    summary:
      "Requested records identifying who owns the cameras, who paid for them, costs, installation, contracts, funding, camera models and locations, administrators, policies and outside-agency access.",
    requestPdf:
      "/documents/sunshine/2026-08-10_flock_system_followup_thread_PUBLIC.pdf",
    responsePdf:
      "/documents/sunshine/2026-08-10_flock_system_followup_thread_PUBLIC.pdf",
    timeline: [
      {
        date: "AUG 10",
        title: "NEW REQUEST SUBMITTED",
        text: "Submitted after LSPD reported that no responsive records existed for the original vehicle-specific request."
      },
      {
        date: "AUG 11",
        title: "25 BUSINESS DAY ESTIMATE",
        text: "LSPD said the request required extensive searching and review and estimated fulfillment within 25 business days."
      },
      {
        date: "AUG 18",
        title: "FOLLOW-UP SENT",
        text: "Requested the detailed explanation for the delay and the earliest specific date and time the records would be available."
      }
    ]
  },

  {
    id: "AUG-07-2026",
    date: "August 7, 2026",
    title: "Vehicle-Specific Flock Records",
    status: "NO RESPONSIVE RECORDS",
    statusClass: "closed",
    summary:
      "Requested Flock detections, photographs, plate reads, timestamps, locations, alerts, searches, audit logs and sharing records associated with a specific vehicle.",
    requestPdf:
      "/documents/sunshine/2026-08-07_vehicle_request_submission_PUBLIC.pdf",
    responsePdf:
      "/documents/sunshine/2026-08-10_vehicle_request_city_response_PUBLIC.pdf",
    officialFormPdf:
      "/documents/sunshine/2026-08-07_official_records_request_form_PUBLIC.pdf",
    timeline: [
      {
        date: "AUG 7",
        title: "REQUEST SUBMITTED",
        text: "Requested all available Flock records associated with the vehicle, including detections, searches, audit logs and sharing records."
      },
      {
        date: "AUG 10",
        title: "LSPD RESPONSE",
        text: "The Police Records Unit responded that it had no responsive records to the request."
      }
    ]
  }
];
---

<BaseLayout
  title="Sunshine Request Tracker | DeFlock Lee's Summit"
  description="Track public records requests involving Lee's Summit's use of Flock Safety and automated license plate readers."
  containerWidth="1050px"
>
  <style>
    .hero {
      padding: 75px 0 65px;
      border-bottom: 1px solid #292929;
    }

    .eyebrow {
      color: #d22b2b;
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 2px;
    }

    h1 {
      margin: 12px 0 20px;
      font-size: clamp(48px, 8vw, 82px);
      line-height: .95;
      letter-spacing: -4px;
    }

    .intro {
      max-width: 760px;
      color: #aaa;
      font-size: 18px;
      line-height: 1.7;
    }

    .request-list {
      padding: 60px 0 100px;
      display: grid;
      gap: 22px;
    }

    .request-card {
      background: #141414;
      border: 1px solid #292929;
    }

    .request-head {
      padding: 30px;
      border-bottom: 1px solid #292929;
    }

    .request-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
    }

    .request-id {
      color: #d22b2b;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 1.5px;
    }

    .status {
      padding: 8px 10px;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 1px;
      white-space: nowrap;
      border: 1px solid #555;
    }

    .status.pending {
      color: #e5b94b;
      border-color: #e5b94b;
    }

    .status.closed {
      color: #aaa;
      border-color: #666;
    }

    .request-card h2 {
      margin: 18px 0 8px;
      font-size: 30px;
      letter-spacing: -1px;
    }

    .request-date {
      color: #777;
      font-size: 12px;
      font-weight: 700;
    }

    .request-summary {
      padding: 25px 30px;
      color: #aaa;
      line-height: 1.7;
    }

    .timeline {
      padding: 0 30px 30px;
    }

    .timeline-title {
      padding-top: 20px;
      margin-bottom: 18px;
      border-top: 1px solid #292929;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 1.5px;
      color: #777;
    }

    .timeline-item {
      display: grid;
      grid-template-columns: 75px 1fr;
      gap: 20px;
      padding: 18px 0;
      border-bottom: 1px solid #222;
    }

    .timeline-item:last-child {
      border-bottom: 0;
    }

    .timeline-date {
      color: #d22b2b;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .timeline-content h3 {
      margin: 0 0 7px;
      font-size: 15px;
    }

    .timeline-content p {
      margin: 0;
      color: #999;
      line-height: 1.6;
    }

    .documents {
      margin: 0 0 30px;
      padding-top: 25px;
      border-top: 1px solid #292929;
    }

    .documents-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 14px;
    }

    .documents-label {
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 1.6px;
      color: #fff;
    }

    .documents-note {
      color: #666;
      font-size: 11px;
    }

    .document-actions {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
    }

    .document-card {
      min-height: 105px;
      padding: 20px;
      display: flex;
      align-items: center;
      gap: 18px;

      background: #1b1b1b;
      border: 1px solid #383838;

      transition:
        transform .15s ease,
        border-color .15s ease,
        background .15s ease;
    }

    .document-card:hover {
      transform: translateY(-2px);
      background: #202020;
      border-color: #d22b2b;
    }

    .document-icon {
      width: 52px;
      height: 60px;

      display: flex;
      align-items: center;
      justify-content: center;

      flex-shrink: 0;

      background: #d22b2b;
      color: white;

      font-size: 12px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .document-info {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .document-type {
      color: #d22b2b;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 1.3px;
    }

    .document-info strong {
      color: #fff;
      font-size: 16px;
      line-height: 1.25;
    }

    .document-open {
      margin-top: 4px;
      color: #888;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: .8px;
    }

    .document-card:hover .document-open {
      color: #fff;
    }

    .notice {
      margin-top: 30px;
      padding: 26px;
      background: #141414;
      border-left: 5px solid #d22b2b;
    }

    .notice strong {
      display: block;
      margin-bottom: 8px;
    }

    .notice p {
      margin: 0;
      color: #999;
      line-height: 1.6;
    }

    @media (max-width: 700px) {
      .request-top {
        flex-direction: column;
      }

      .document-actions {
        grid-template-columns: 1fr;
      }

      .timeline-item {
        grid-template-columns: 1fr;
        gap: 7px;
      }

      h1 {
        letter-spacing: -3px;
      }
    }
  </style>

  <main>

  <section class="hero">
    <div class="container">

      <div class="eyebrow">
        MISSOURI SUNSHINE LAW
      </div>

      <h1>
        REQUEST TRACKER
      </h1>

      <p class="intro">
        This page tracks public records requests involving Lee's Summit's
        use of Flock Safety and automated license plate reader technology.
        Requests, responses and produced records will be added as they are received.
      </p>

    </div>
  </section>

  <div class="container">

    <div class="request-list">

      {requests.map((request) => (

        <article class="request-card">

          <div class="request-head">

            <div class="request-top">

              <div class="request-id">
                REQUEST {request.id}
              </div>

              <div class={`status ${request.statusClass}`}>
                {request.status}
              </div>

            </div>

            <h2>{request.title}</h2>

            <div class="request-date">
              SUBMITTED {request.date}
            </div>

          </div>


          <div class="request-summary">
            {request.summary}
          </div>


          <div class="timeline">

            <div class="timeline-title">
              REQUEST TIMELINE
            </div>

            <div class="documents">

              <div class="documents-header">
                <span class="documents-label">PUBLIC DOCUMENTS</span>
                <span class="documents-note">Personal information redacted</span>
              </div>

              <div class="document-actions">

                <a
                  class="document-card request-document"
                  href={request.requestPdf}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <div class="document-icon">PDF</div>

                  <div class="document-info">
                    <span class="document-type">ORIGINAL REQUEST</span>
                    <strong>Read the Sunshine Request</strong>
                    <span class="document-open">OPEN DOCUMENT →</span>
                  </div>
                </a>

                <a
                  class="document-card response-document"
                  href={request.responsePdf}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <div class="document-icon">PDF</div>

                  <div class="document-info">
                    <span class="document-type">CITY RESPONSE</span>
                    <strong>Read the City's Response</strong>
                    <span class="document-open">OPEN DOCUMENT →</span>
                  </div>
                </a>

                {request.officialFormPdf && (
                  <a
                    class="document-card official-document"
                    href={request.officialFormPdf}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <div class="document-icon">PDF</div>

                    <div class="document-info">
                      <span class="document-type">OFFICIAL CITY FORM</span>
                      <strong>View the Official Records Request Form</strong>
                      <span class="document-open">OPEN DOCUMENT →</span>
                    </div>
                  </a>
                )}

              </div>

            </div>

            {request.timeline.map((event) => (

              <div class="timeline-item">

                <div class="timeline-date">
                  {event.date}
                </div>

                <div class="timeline-content">

                  <h3>{event.title}</h3>

                  <p>{event.text}</p>

                </div>

              </div>

            ))}

          </div>

        </article>

      ))}


      <div class="notice">

        <strong>
          ORIGINAL DOCUMENTS
        </strong>

        <p>
          Public copies of the original requests and City responses will be
          added after personal information is removed.
        </p>

      </div>

    </div>

  </div>

  </main>

</BaseLayout>
