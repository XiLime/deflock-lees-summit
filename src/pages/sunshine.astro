---

<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <title>Sunshine Request Tracker | DeFlock Lee's Summit</title>

  <meta
    name="description"
    content="Track public records requests involving Lee's Summit's use of Flock Safety and automated license plate readers."
  />

  <style>
    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: #0b0b0b;
      color: #f5f5f5;
      font-family: Arial, Helvetica, sans-serif;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1050px, calc(100% - 40px));
      margin: auto;
    }

    header {
      border-bottom: 1px solid #292929;
    }

    nav {
      min-height: 78px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      font-size: 21px;
      font-weight: 900;
    }

    .brand span {
      color: #d22b2b;
    }

    .back {
      font-size: 12px;
      font-weight: 800;
    }

    .hero {
      padding: 75px 0 65px;
      border-bottom: 1px solid #292929;
    }

    .eyebrow {
      color: #d22b2b;
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 2px;
    }

    h1 {
      margin: 12px 0 20px;
      font-size: clamp(48px, 8vw, 82px);
      line-height: .95;
      letter-spacing: -4px;
    }

    .intro {
      max-width: 760px;
      color: #aaa;
      font-size: 18px;
      line-height: 1.7;
    }

    .request-list {
      padding: 60px 0 100px;
      display: grid;
      gap: 22px;
    }

    .request-card {
      background: #141414;
      border: 1px solid #292929;
    }

    .request-head {
      padding: 30px;
      border-bottom: 1px solid #292929;
    }

    .request-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
    }

    .request-id {
      color: #d22b2b;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 1.5px;
    }

    .status {
      padding: 8px 10px;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 1px;
      white-space: nowrap;
      border: 1px solid #555;
    }

    .status.pending {
      color: #e5b94b;
      border-color: #e5b94b;
    }

    .status.closed {
      color: #aaa;
      border-color: #666;
    }

    .request-card h2 {
      margin: 18px 0 8px;
      font-size: 30px;
      letter-spacing: -1px;
    }

    .request-date {
      color: #777;
      font-size: 12px;
      font-weight: 700;
    }

    .request-summary {
      padding: 25px 30px;
      color: #aaa;
      line-height: 1.7;
    }

    .timeline {
      padding: 0 30px 30px;
    }

    .timeline-title {
      padding-top: 20px;
      margin-bottom: 18px;
      border-top: 1px solid #292929;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 1.5px;
      color: #777;
    }

    .timeline-item {
      display: grid;
      grid-template-columns: 75px 1fr;
      gap: 20px;
      padding: 18px 0;
      border-bottom: 1px solid #222;
    }

    .timeline-item:last-child {
      border-bottom: 0;
    }

    .timeline-date {
      color: #d22b2b;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .timeline-content h3 {
      margin: 0 0 7px;
      font-size: 15px;
    }

    .timeline-content p {
      margin: 0;
      color: #999;
      line-height: 1.6;
    }

    .notice {
      margin-top: 30px;
      padding: 26px;
      background: #141414;
      border-left: 5px solid #d22b2b;
    }

    .notice strong {
      display: block;
      margin-bottom: 8px;
    }

    .notice p {
      margin: 0;
      color: #999;
      line-height: 1.6;
    }

    @media (max-width: 700px) {
      .request-top {
        flex-direction: column;
      }

      .timeline-item {
        grid-template-columns: 1fr;
        gap: 7px;
      }

      h1 {
        letter-spacing: -3px;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="container">
    <nav>

      <a href="/" class="brand">
        DEFLOCK <span>LEE'S SUMMIT</span>
      </a>

      <a href="/" class="back">
        ← BACK HOME
      </a>

    </nav>
  </div>
</header>

<main>

<section class="hero">
  <div class="container">

    <div class="eyebrow">
      MISSOURI SUNSHINE LAW
    </div>

    <h1>
      REQUEST TRACKER
    </h1>

    <p class="intro">
      This page tracks public records requests involving Lee's Summit's
      use of Flock Safety and automated license plate reader technology.
      Requests, responses and produced records will be added as they are received.
    </p>

  </div>
</section>

<div class="container">

  <div class="request-list">

    {requests.map((request) => (

      <article class="request-card">

        <div class="request-head">

          <div class="request-top">

            <div class="request-id">
              REQUEST {request.id}
            </div>

            <div class={`status ${request.statusClass}`}>
              {request.status}
            </div>

          </div>

          <h2>{request.title}</h2>

          <div class="request-date">
            SUBMITTED {request.date}
          </div>

        </div>


        <div class="request-summary">
          {request.summary}
        </div>


        <div class="timeline">

          <div class="timeline-title">
            REQUEST TIMELINE
          </div>

          {request.timeline.map((event) => (

            <div class="timeline-item">

              <div class="timeline-date">
                {event.date}
              </div>

              <div class="timeline-content">

                <h3>{event.title}</h3>

                <p>{event.text}</p>

              </div>

            </div>

          ))}

        </div>

      </article>

    ))}


    <div class="notice">

      <strong>
        ORIGINAL DOCUMENTS
      </strong>

      <p>
        Public copies of the original requests and City responses will be
        added after personal information is removed.
      </p>

    </div>

  </div>

</div>

</main>

</body>
</html>