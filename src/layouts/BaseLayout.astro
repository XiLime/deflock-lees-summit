---
export interface Props {
  title: string;
  description: string;
  image?: string;
  containerWidth?: string;
}

const {
  title,
  description,
  image = "/og-image.png",
  containerWidth = "1050px",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const navLinks = [
  { href: "/records", label: "FROM THE RECORDS" },
  { href: "/sunshine", label: "SUNSHINE TRACKER" },
  { href: "/take-action", label: "TAKE ACTION" },
  { href: "/#mission", label: "ABOUT" },
  { href: "/contact", label: "CONTACT" },
];
---

<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <title>{title}</title>

  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-192x192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="DeFlock Lee's Summit" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <style is:global define:vars={{ containerWidth }}>
    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: #0b0b0b;
      color: #f5f5f5;
      font-family: Arial, Helvetica, sans-serif;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    a:focus-visible,
    button:focus-visible,
    input:focus-visible,
    textarea:focus-visible,
    select:focus-visible {
      outline: 2px solid #d22b2b;
      outline-offset: 2px;
    }

    .skip-link {
      position: absolute;
      top: -60px;
      left: 8px;
      z-index: 100;
      padding: 12px 18px;
      background: #d22b2b;
      color: #fff;
      font-size: 13px;
      font-weight: 900;
      letter-spacing: .5px;
      transition: top .15s ease;
    }

    .skip-link:focus {
      top: 8px;
    }

    .container {
      width: min(var(--containerWidth), calc(100% - 40px));
      margin: auto;
    }

    /* the nav always gets room for the full link row, independent of
       how narrow a given page's own content container is */
    header .container {
      width: min(1120px, calc(100% - 40px));
    }

    header {
      border-bottom: 1px solid #292929;
      background: #0b0b0b;
    }

    nav {
      min-height: 78px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      position: relative;
    }

    .brand {
      font-weight: 900;
      letter-spacing: -1px;
      font-size: 21px;
    }

    .brand span {
      color: #d22b2b;
    }

    .nav-links {
      display: flex;
      gap: 28px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.6px;
    }

    .nav-links a:hover {
      color: #d22b2b;
    }

    .nav-toggle-checkbox {
      display: none;
    }

    .nav-toggle-label {
      display: none;
      font-size: 26px;
      line-height: 1;
      cursor: pointer;
      padding: 4px;
    }

    footer {
      padding: 45px 0;
      border-top: 1px solid #292929;
      color: #777;
      font-size: 13px;
    }

    .footer-inner {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 24px;
      align-items: center;
      justify-content: space-between;
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }

    .footer-links a:hover {
      color: #d22b2b;
    }

    @media (max-width: 800px) {
      .nav-toggle-label {
        display: block;
      }

      .nav-links {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        flex-direction: column;
        gap: 0;
        background: #0b0b0b;
        border-top: 1px solid #292929;
        border-bottom: 1px solid #292929;
        z-index: 20;
      }

      .nav-links a {
        padding: 16px 20px;
        border-bottom: 1px solid #1c1c1c;
      }

      .nav-toggle-checkbox:checked ~ .nav-links {
        display: flex;
      }
    }
  </style>

  <slot name="head" />
</head>

<body>

<a href="#main-content" class="skip-link">Skip to content</a>

<header>
  <div class="container">
    <nav aria-label="Primary">

      <a href="/" class="brand">
        DEFLOCK <span>LEE'S SUMMIT</span>
      </a>

      <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" />
      <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation">
        &#9776;
      </label>

      <div class="nav-links">
        {navLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>

    </nav>
  </div>
</header>

<slot />

<footer>
  <div class="container footer-inner">
    <div>
      DeFlock Lee's Summit &bull; Lee's Summit, Missouri
    </div>
    <div class="footer-links">
      <a href="/faq">FAQ</a>
      <a href="/glossary">GLOSSARY</a>
      <a href="/handout">PRINTABLE HANDOUT</a>
      <a href="/press">PRESS</a>
      <a href="/updates">UPDATES</a>
    </div>
  </div>
</footer>

</body>
</html>
